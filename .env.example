# Puerto del servidor
PORT=3000

# Directorio de datos persistente para SQLite
DATA_DIR=/data

# Dominio público en Dokploy (importante para que los QRs abran la URL correcta al escanear con la cámara del celular)
BASE_URL=https://matafuegos.tu-empresa.com

# Webhook de Microsoft Power Automate (opcional, para sincronizar cada inspección en vivo con Excel Online 365)
M365_WEBHOOK_URL=
