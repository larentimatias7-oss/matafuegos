# ==============================================================================
# Milicic S.A. - Configuración de Entorno (.env)
# ==============================================================================

# Entorno y Zona Horaria (Obligatorio Argentina)
NODE_ENV=production
TZ=America/Argentina/Buenos_Aires
PORT=3000

# Directorio de datos persistente para SQLite (Volumen Docker /data)
DATA_DIR=/data

# Dominio público para escaneo de códigos QR desde celulares
# Ejemplo: https://matafuegos.milicic.com.ar o URL pública de Dokploy
BASE_URL=https://matafuegos.milicic.com.ar

# Seguridad y CORS
# Dominios autorizados separados por coma, o * para permitir todos
CORS_ORIGIN=*

# ==============================================================================
# Microsoft Entra ID (OIDC) / Autenticación Corporativa
# ==============================================================================
# Modo: 'entra' para login corporativo Microsoft 365, o 'local' para desarrollo
AUTH_PROVIDER=local
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://matafuegos.milicic.com.ar/api/auth/entra/callback

# ==============================================================================
# Integraciones Microsoft 365 (Teams & Power Automate)
# ==============================================================================
# Webhook HTTP instantáneo para notificar anomalías y fallas en canal de Teams
M365_WEBHOOK_URL=

# ==============================================================================
# Notificaciones por Correo Electrónico (SMTP)
# ==============================================================================
# Resúmenes automáticos de alertas de vencimiento (60 / 30 / 15 días)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@milicic.com.ar
SMTP_PASS=
SMTP_FROM="Seguridad e Higiene Milicic <notificaciones@milicic.com.ar>"
ALERT_RECIPIENTS=hys@milicic.com.ar
